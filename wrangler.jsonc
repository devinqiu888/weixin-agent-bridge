{
 "name":"weixin-agent-bridge", "main":"src/index.ts", "compatibility_date":"2026-10-30",
 "durable_objects":{"code_update_strategy":{"mode":"immediate"},"bindings":[{"name":"ACCOUNTS","class_name":"WeixinAccount"},{"name":"OAUTH","class_name":"OAuthState"}]},
